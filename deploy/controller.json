{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
    "name": "sentrycheck-controller",
    "namespace": "sentrycheck-system"
  },
  "spec": {
    "replicas": 1,
    "selector": {
      "matchLabels": {
        "app": "sentrycheck-controller"
      }
    },
    "template": {
      "metadata": {
        "labels": {
          "app": "sentrycheck-controller"
        }
      },
      "spec": {
        "serviceAccountName": "sentrycheck-controller",
        "securityContext": {
          "runAsNonRoot": true,
          "runAsUser": 65532,
          "seccompProfile": {
            "type": "RuntimeDefault"
          }
        },
        "containers": [
          {
            "name": "controller",
            "image": "sentrycheck-integration:0.3.0",
            "imagePullPolicy": "IfNotPresent",
            "command": [
              "/sentrycheck-admission",
              "controller"
            ],
            "ports": [
              {
                "containerPort": 8080
              }
            ],
            "readinessProbe": {
              "httpGet": {
                "path": "/readyz",
                "port": 8080
              },
              "periodSeconds": 10
            },
            "livenessProbe": {
              "httpGet": {
                "path": "/healthz",
                "port": 8080
              }
            },
            "resources": {
              "requests": {
                "cpu": "50m",
                "memory": "64Mi"
              },
              "limits": {
                "cpu": "500m",
                "memory": "256Mi"
              }
            },
            "securityContext": {
              "allowPrivilegeEscalation": false,
              "readOnlyRootFilesystem": true,
              "capabilities": {
                "drop": [
                  "ALL"
                ]
              }
            },
            "volumeMounts": [
              {
                "name": "config",
                "mountPath": "/etc/sentrycheck",
                "readOnly": true
              }
            ]
          }
        ],
        "volumes": [
          {
            "name": "config",
            "configMap": {
              "name": "sentrycheck-controller-config"
            }
          }
        ]
      }
    }
  }
}
