{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "admissionregistration.k8s.io/v1",
      "kind": "MutatingAdmissionPolicy",
      "metadata": {
        "name": "sentrycheck-observability"
      },
      "spec": {
        "failurePolicy": "Ignore",
        "reinvocationPolicy": "IfNeeded",
        "matchConstraints": {
          "resourceRules": [
            {
              "apiGroups": [
                ""
              ],
              "apiVersions": [
                "v1"
              ],
              "operations": [
                "CREATE"
              ],
              "resources": [
                "pods"
              ]
            }
          ]
        },
        "matchConditions": [
          {
            "name": "declared-isolation",
            "expression": "has(object.metadata.labels) && 'sentrycheck.io/require-isolation' in object.metadata.labels && object.metadata.labels['sentrycheck.io/require-isolation'] == 'true'"
          }
        ],
        "mutations": [
          {
            "patchType": "ApplyConfiguration",
            "applyConfiguration": {
              "expression": "Object{metadata: Object.metadata{annotations: {'sentrycheck.io/admission-observer': 'enabled'}}}"
            }
          }
        ]
      }
    },
    {
      "apiVersion": "admissionregistration.k8s.io/v1",
      "kind": "MutatingAdmissionPolicyBinding",
      "metadata": {
        "name": "sentrycheck-observability"
      },
      "spec": {
        "policyName": "sentrycheck-observability"
      }
    }
  ]
}
