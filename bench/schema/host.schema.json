{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "host_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"
    },
    "recorded_at": {
      "type": "string"
    },
    "platform": {
      "type": "string"
    },
    "os_release": {
      "type": "string"
    },
    "kernel": {
      "type": "string"
    },
    "architecture": {
      "type": "string"
    },
    "cpu": {
      "type": "object",
      "properties": {
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "cores": {
          "type": "integer",
          "minimum": 1
        },
        "threads_per_core": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "governor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "smt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "turbo": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "pinning": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "model",
        "cores",
        "threads_per_core",
        "governor",
        "smt",
        "turbo",
        "pinning"
      ],
      "additionalProperties": false
    },
    "memory": {
      "type": "object",
      "properties": {
        "total_mb": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "swap": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "transparent_hugepage": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "total_mb",
        "swap",
        "transparent_hugepage"
      ],
      "additionalProperties": false
    },
    "numa": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "storage": {
      "type": "object",
      "properties": {
        "work_root": {
          "type": "string"
        },
        "filesystem": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "free_mb": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "device": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "work_root",
        "filesystem",
        "free_mb",
        "device"
      ],
      "additionalProperties": false
    },
    "network": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "clock": {
      "type": "object",
      "properties": {
        "timezone": {
          "type": "string"
        },
        "synced": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "unix_now": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "timezone",
        "synced",
        "unix_now"
      ],
      "additionalProperties": false
    },
    "load_average": {
      "type": "object",
      "properties": {
        "one": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "five": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "fifteen": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "one",
        "five",
        "fifteen"
      ],
      "additionalProperties": false
    },
    "virtualization": {
      "type": "object",
      "properties": {
        "is_wsl": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "nested_kvm": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "provider": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "is_wsl",
        "nested_kvm",
        "provider"
      ],
      "additionalProperties": false
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "name",
          "path",
          "sha256",
          "version"
        ],
        "additionalProperties": false
      }
    },
    "host_load_controlled": {
      "type": "boolean"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "host_id",
    "recorded_at",
    "platform",
    "os_release",
    "kernel",
    "architecture",
    "cpu",
    "memory",
    "numa",
    "storage",
    "network",
    "clock",
    "load_average",
    "virtualization",
    "tools",
    "host_load_controlled",
    "notes"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SENTRYCHECK benchmark host record",
  "$id": "urn:sentrycheck:bench:host:1.0"
}
