{
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "command": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "env": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600
    },
    "repetitions": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "expected_exit_code": {
      "type": "integer"
    },
    "compare_stdout": {
      "type": "boolean"
    },
    "compare_stderr": {
      "type": "boolean"
    },
    "timing_ratio": {
      "type": "number",
      "exclusiveMinimum": 1
    },
    "timing_min_native_ms": {
      "type": "integer",
      "minimum": 0
    },
    "coverage": {
      "type": "string",
      "enum": [
        "smoke",
        "representative"
      ]
    }
  },
  "required": [
    "name"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SENTRYCHECK workload profile"
}
